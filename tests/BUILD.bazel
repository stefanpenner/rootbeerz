load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load(":cc_probe.bzl", "cc_probe")

py_test(
    name = "ci_test",
    srcs = ["ci_test.py"],
    data = [
        "//:.bazelversion",
        "//.github/actions/build:action.yml",
        "//.github/actions/setup-bazel:action.yml",
        "//.github/workflows:ci.yml",
    ],
    env = {
        "BAZELVERSION": "$(rootpath //:.bazelversion)",
        "SETUP_BAZEL_ACTION": "$(rootpath //.github/actions/setup-bazel:action.yml)",
        "BUILD_ACTION": "$(rootpath //.github/actions/build:action.yml)",
        "WORKFLOW": "$(rootpath //.github/workflows:ci.yml)",
    },
    size = "small",
)

