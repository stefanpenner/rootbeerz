load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_library(
    name = "sourcelib",
    srcs = ["sourcelib.py"],
    imports = ["."],
)

py_test(
    name = "source_test",
    srcs = ["source_test.py"],
    data = [
        "//runtimes/bun:manifest.json",
        "@bun_1_src//:package.json",
        "@bun_1_src//:root_sources",
        "@bun_1_tarball//file",
    ],
    env = {
        "BUN_PATCHED_MARKER": "$(rootpath @bun_1_src//:package.json)",
        "BUN_TARBALL": "$(rootpath @bun_1_tarball//file)",
        "RUNTIME_MANIFEST": "$(rootpath //runtimes/bun:manifest.json)",
    },
    size = "small",
    deps = [":sourcelib"],
)

py_test(
    name = "inputs_test",
    srcs = ["inputs_test.py"],
    data = [
        "//runtimes/bun:inputs_1.json",
        "//runtimes/bun:manifest.json",
        "@bun_1_src//:Cargo.lock",
    ],
    env = {
        "BUN_CARGO_LOCK": "$(rootpath @bun_1_src//:Cargo.lock)",
        "BUN_INPUTS": "$(rootpath //runtimes/bun:inputs_1.json)",
        "RUNTIME_MANIFEST": "$(rootpath //runtimes/bun:manifest.json)",
    },
    size = "small",
)

py_test(
    name = "driver_test",
    srcs = ["driver_test.py"],
    data = ["//runtimes/bun:build_bun.py"],
    env = {"BUILD_BUN": "$(rootpath //runtimes/bun:build_bun.py)"},
    size = "small",
)

alias(
    name = "stock_bun",
    actual = select({
        "@platforms//os:macos": "@bun_1_stock_darwin_arm64//:bun",
        "//conditions:default": "@bun_1_stock_linux_x64//:bun",
    }),
)

_FIXTURES = [
    "probe_fetch.js",
    "root_count.js",
    "//runtimes/bun:manifest.json",
    "//trust/testing:fixtures/empty.pem",
    "//trust/testing:fixtures/emsign-roots.pem",
    "//trust/testing:fixtures/testonly-ca.pem",
    "//trust/testing:fixtures/testonly-leaf.key",
    "//trust/testing:fixtures/testonly-leaf.pem",
    "//trust/testing:probe.js",
    "//trust:mozilla-no-emsign.pem",
]

_ENV = {
    "EMPTY_STORE": "$(rootpath //trust/testing:fixtures/empty.pem)",
    "EMSIGN_STORE": "$(rootpath //trust/testing:fixtures/emsign-roots.pem)",
    "PINNED_STORE": "$(rootpath //trust:mozilla-no-emsign.pem)",
    "PROBE_FETCH": "$(rootpath probe_fetch.js)",
    "PROBE_HTTPS": "$(rootpath //trust/testing:probe.js)",
    "ROOT_COUNT_JS": "$(rootpath root_count.js)",
    "RUNTIME_MANIFEST": "$(rootpath //runtimes/bun:manifest.json)",
    "TEST_CA": "$(rootpath //trust/testing:fixtures/testonly-ca.pem)",
    "TEST_LEAF": "$(rootpath //trust/testing:fixtures/testonly-leaf.pem)",
    "TEST_LEAF_KEY": "$(rootpath //trust/testing:fixtures/testonly-leaf.key)",
}

py_library(
    name = "hermetic_lib",
    srcs = ["hermetic_test.py"],
    imports = ["."],
    deps = ["//trust/testing:trustlib"],
)

# Needs no Bun build.
py_test(
    name = "stock_control_test",
    srcs = ["hermetic_test.py"],
    main = "hermetic_test.py",
    args = ["StockControl"],
    data = _FIXTURES + [":stock_bun"],
    env = _ENV | {"STOCK_BUN": "$(rootpath :stock_bun)"},
    size = "medium",
    deps = ["//trust/testing:trustlib"],
)

# Needs no Bun build. It fails if the no-roots tests stop failing on the stock binary.
py_test(
    name = "stock_teeth_test",
    srcs = ["stock_teeth_test.py"],
    data = _FIXTURES + [":stock_bun"],
    env = _ENV | {"STOCK_BUN": "$(rootpath :stock_bun)"},
    size = "medium",
    deps = [
        ":hermetic_lib",
        "//trust/testing:trustlib",
    ],
)

# Needs the long Bun build, so //... does not start it.
py_test(
    name = "hermetic_1_test",
    srcs = ["hermetic_test.py"],
    main = "hermetic_test.py",
    data = _FIXTURES + [
        ":stock_bun",
        "//runtimes/bun:bun_1",
    ],
    env = _ENV | {
        "ROOTBEER_BUN": "$(rootpath //runtimes/bun:bun_1)",
        "STOCK_BUN": "$(rootpath :stock_bun)",
    },
    size = "medium",
    tags = ["manual"],
    deps = ["//trust/testing:trustlib"],
)

# A result that cannot be decided is Inconclusive, not a pass.
py_test(
    name = "network_1_test",
    srcs = ["network_test.py"],
    main = "network_test.py",
    data = _FIXTURES + [
        ":stock_bun",
        "//runtimes/bun:bun_1",
    ],
    env = _ENV | {
        "ROOTBEER_BUN": "$(rootpath //runtimes/bun:bun_1)",
        "STOCK_BUN": "$(rootpath :stock_bun)",
    },
    size = "large",
    tags = [
        "external",
        "manual",
        "no-cache",
        "no-remote",
        "requires-network",
    ],
    deps = ["//trust/testing:trustlib"],
)

# Needs the long Bun build, so //... does not start it.
py_test(
    name = "system_ca_1_test",
    srcs = ["system_ca_test.py"],
    main = "system_ca_test.py",
    data = [
        "probe_fetch.js",
        "//runtimes/bun:bun_1",
        "//trust/testing:fixtures/empty.pem",
        "//trust/testing:probe.js",
    ],
    env = {
        "EMPTY_STORE": "$(rootpath //trust/testing:fixtures/empty.pem)",
        "PROBE_FETCH": "$(rootpath probe_fetch.js)",
        "PROBE_HTTPS": "$(rootpath //trust/testing:probe.js)",
        "ROOTBEER_BUN": "$(rootpath //runtimes/bun:bun_1)",
    },
    size = "large",
    tags = [
        "external",
        "manual",
        "no-cache",
        "no-remote",
        "requires-network",
    ],
    deps = ["//trust/testing:trustlib"],
)
