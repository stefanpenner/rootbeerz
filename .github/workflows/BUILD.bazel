load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

exports_files(
    [
        "ci.yml",
        "gha.py",
        "release.yml",
        "version-bumps.yml",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "gha",
    srcs = ["gha.py"],
    imports = ["."],
)

py_test(
    name = "gha_test",
    srcs = ["gha_test.py"],
    deps = [":gha"],
    data = ["//:.bazelversion"],
    env = {"BAZELVERSION": "$(rootpath //:.bazelversion)"},
    size = "small",
)
